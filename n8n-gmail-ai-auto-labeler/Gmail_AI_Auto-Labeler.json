    {
      "parameters": {
        "jsCode": "// Normalize the incoming Gmail item into a compact object for the AI prompt.\nconst msg = $input.item.json;\n\nconst subject = msg.subject || msg.Subject || '';\nconst from = msg.from || msg.From || '';\nconst snippet = msg.snippet || '';\nconst textBody = (msg.text || msg.textPlain || msg.textHtml || '').toString().slice(0, 1500);\nconst messageId = msg.id;\nconst threadId = msg.threadId;\n\nreturn {\n  json: {\n    messageId,\n    threadId,\n    from,\n    subject,\n    bodyPreview: textBody || snippet\n  }\n};"
      },
      "id": "ca86d79d-1f88-44dd-96b9-27a2f93d8d26",
      "name": "Prepare Email Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -976,
        896
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json;\nlet category = 'Other';\nlet debugReason = '';\n\nconst raw = (response.output || '').toString().trim();\n\nif (!raw) {\n  debugReason = 'EMPTY_OUTPUT: ' + JSON.stringify(response).slice(0, 300);\n} else {\n  const cleaned = raw.replace(/[*_`\"'.,:;]/g, '').trim();\n  const allowedCheck = ['Newsletters','Advertisings','Security','Orders_Shipping','Payments_Receipts','Appointments','Work','Events_Meetups','Real_Estate','Social_Notifications','Other'];\n  const found = allowedCheck.find(c => cleaned === c)\n    || allowedCheck.find(c => cleaned.includes(c));\n  if (found) {\n    category = found;\n  } else {\n    debugReason = 'NO_MATCHING_CATEGORY_IN_RESPONSE: ' + raw.slice(0, 300);\n  }\n}\n\nconst allowed = ['Newsletters','Advertisings','Security','Orders_Shipping','Payments_Receipts','Appointments','Work','Events_Meetups','Real_Estate','Social_Notifications','Other'];\nif (!allowed.includes(category)) {\n  if (!debugReason) debugReason = 'CATEGORY_NOT_IN_ALLOWED_LIST: ' + category;\n  category = 'Other';\n}\n\nconst prev = $items('Prepare Email Data')[$itemIndex].json;\n\nreturn {\n  json: {\n    messageId: prev.messageId,\n    threadId: prev.threadId,\n    category,\n    _debugReason: debugReason\n  }\n};"
      },
